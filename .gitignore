# ─────────────────────────────────────────────────────────────────────────────
# Rural Healthcare AI Navigation System — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & Secrets (NEVER commit API keys) ────────────────────────────
.env
*.env
.env.local
.env.production
secrets.toml

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
env/
.venv/
ENV/

# ── Distribution / Packaging ─────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── pytest / Testing ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Database (auto-created at runtime) ───────────────────────────────────────
data/healthcare.db
data/*.db
data/*.sqlite
data/*.sqlite3

# ── Vector store (auto-created at runtime) ───────────────────────────────────
rag/chroma_db/
rag/__pycache__/

# ── Logs (auto-created at runtime) ───────────────────────────────────────────
logs/*.log
logs/*.json

# ── Streamlit cache ───────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Large media files (generated outputs) ────────────────────────────────────
*.mp4
*.avi
*.mov
*.mkv

# ── OS specific ───────────────────────────────────────────────────────────────
.DS_Store
desktop.ini
ehthumbs.db

# ── Temporary files ───────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.backup
tmp/
temp/
