# ============================================================
# Rural Healthcare AI Navigation System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# ── LLM Provider (choose one) ────────────────────────────────
# Google Gemini (PREFERRED — get free key at https://ai.google.dev)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (optional)
# OPENAI_API_KEY=your_openai_api_key_here

# Groq — free tier (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ── LLM Configuration ────────────────────────────────────────
LLM_PROVIDER=google
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# Groq model (used when GROQ_API_KEY is set)
GROQ_MODEL=llama-3.1-8b-instant

# ── Application ──────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# !! CHANGE THIS in production — use at least 32 random characters
SECRET_KEY=change-me-in-production-use-32-random-chars!

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/healthcare.db
DB_ECHO=false

# ── RAG / Vector Store ───────────────────────────────────────
CHROMA_PERSIST_DIR=./rag/chroma_db
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
EMBEDDING_MODEL=models/embedding-001

# ── Healthcare Data Paths ─────────────────────────────────────
FACILITY_DATA_PATH=./data/healthcare_facilities.csv
SPECIALIST_DATA_PATH=./data/specialists.csv

# ── Emergency Configuration ───────────────────────────────────
EMERGENCY_HOTLINE=108
AMBULANCE_SERVICE=102
HEALTH_HELPLINE=104

# ── Session & Security ────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
MAX_CONVERSATION_TURNS=50

# ── Monitoring ────────────────────────────────────────────────
ENABLE_ANALYTICS=true
AUDIT_LOG_PATH=./logs/audit.log
